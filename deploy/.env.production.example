# VPS için ortam değişkenleri şablonu.
# Sunucuda repo kökünde ".env.production" olarak kopyalayıp doldur:
#   cp deploy/.env.production.example .env.production
#   nano .env.production
# ASLA git'e commit etme (.gitignore .env* dosyalarını zaten hariç tutuyor).

# --- Veritabanı (güçlü, rastgele bir şifre üret: openssl rand -base64 24) ---
POSTGRES_USER=planova
POSTGRES_PASSWORD=BURAYA_GUCLU_SIFRE
POSTGRES_DB=planova_db

# --- Uygulama ---
BACKEND_PORT=3001
APP_NAME=Planova
ENABLE_SWAGGER=false

# --- JWT (Cloud Run'daki DEĞERLERİN AYNISINI kullan; değiştirirsen tüm
#     kullanıcıların oturumu kapanır) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=90d

# --- CORS ---
CORS_ORIGINS=*

# --- Platform yöneticileri (lisans ekranını görecek hesaplar) ---
PLATFORM_ADMIN_EMAILS=iscelikler@gmail.com,alisancelik7140@gmail.com

# --- Firebase (push bildirimleri) — Cloud Run'daki değerlerin aynısı ---
FIREBASE_PROJECT_ID=mimar-app-2e7ab
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
IOS_BUNDLE_ID=com.mimar.app

# --- iOS bildirimleri doğrudan Apple'a (APNs) ---
# Firebase'e yüklenen APNs anahtarı. .p8 dosyası base64'e çevrilip TEK SATIR
# yazılır: base64 -w0 AuthKey_XXXXXXXXXX.p8
# Boş bırakılırsa eski FCM batchImport yolu kullanılır (29 Eyl 2027'de kapanıyor).
APNS_KEY_ID=
APNS_TEAM_ID=4FXVMZW9NP
APNS_PRIVATE_KEY_BASE64=

# --- Google / Apple giriş ---
GOOGLE_CLIENT_ID=863980504433-ui54bn3hnab3spo3san3l5afmo2f6uto.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=4FXVMZW9NP
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Lisans hatırlatma bildiriminde gösterilen iletişim adresi ---
SUPPORT_CONTACT_EMAIL=iletisim@kozmozinovasyon.com

# --- E-posta (şifre sıfırlama) ---
RESEND_API_KEY=
MAIL_FROM=Planova <noreply@planovaapp.com>
PASSWORD_RESET_URL=https://api.planovaapp.com/reset-password
